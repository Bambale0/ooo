# Copy to the deployment's .backup.env (chmod 600). Never commit the real file.
# Public age recipient only; the private identity belongs to the recovery operator.
AGE_RECIPIENT=
WAL_ARCHIVE_DIR=/var/lib/postgresql/archive
WAL_S3_URI=s3://YOUR-RUSSIAN-BACKUP-BUCKET/neironych/wal
BACKUP_S3_URI=s3://YOUR-RUSSIAN-BACKUP-BUCKET/neironych/base
BACKUP_DIR=/var/lib/postgresql/archive/base
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=ru-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# BACKUP_LOCAL_ONLY=1 is exclusively for isolated tests, never production.
