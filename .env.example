APP_ENV=test
APP_NAME=neironych
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://neironych:neironych@postgres:5432/neironych  # pragma: allowlist secret
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://redis:6379/0
ADMIN_API_TOKEN=change-me
ADMIN_TELEGRAM_ID=
TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
RUB_PER_USDT=100.00
ARGOLINK_BASE_URL=https://argolink.io
ARGOLINK_API_KEY=
PROVIDER_NOTIFICATION_WEBHOOK_SECRET=
INFAI_SYSTEM_TOKEN=
# INFAI_USER_ID=your_numeric_account_id
PROVIDER_CREDENTIALS_MASTER_KEY=change-this-to-a-random-secret-at-least-32-characters  # pragma: allowlist secret
ARGOLINK_TIMEOUT_SECONDS=30
ARGOLINK_HTTP_CONNECT_TIMEOUT_SECONDS=5
ARGOLINK_HTTP_READ_TIMEOUT_SECONDS=30
ARGOLINK_HTTP_WRITE_TIMEOUT_SECONDS=30
ARGOLINK_HTTP_POOL_TIMEOUT_SECONDS=5
ARGOLINK_HTTP_MAX_CONNECTIONS=100
ARGOLINK_HTTP_MAX_KEEPALIVE_CONNECTIONS=50
ARGOLINK_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
ARGOLINK_SUBMIT_RPS=10
ARGOLINK_POLL_RPS=50
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot
CRYPTO_PAY_TIMEOUT_SECONDS=10
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=20
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_MEDIA_BASE_URL=
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_STORAGE_DIR=./var/media
MEDIA_RETENTION_HOURS=24
MEDIA_MAX_DOWNLOAD_BYTES=524288000
S3_ENDPOINT_URL=
S3_REGION_NAME=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=20
WORKER_SUBMIT_CONCURRENCY=10
WORKER_POLL_CONCURRENCY=10
WORKER_INITIAL_POLL_DELAY_SECONDS=5
WORKER_POLL_BACKOFF_BASE_SECONDS=5
WORKER_POLL_BACKOFF_MAX_SECONDS=30
WORKER_MAX_RETRIES=3
# New jobs only after an explicitly retryable terminal failure; 0 disables, maximum 2.
WORKER_GENERATION_MAX_RETRIES=2
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_PROVIDER_PROCESSING_TIMEOUT_SECONDS=1800
WORKER_SHUTDOWN_GRACE_SECONDS=25

WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_RETRY_INTERVAL_SECONDS=900
WEBHOOK_RETRY_WINDOW_SECONDS=86400
WEBHOOK_CLAIM_LEASE_SECONDS=60
WEBHOOK_WORKER_BATCH_SIZE=50
WEBHOOK_WORKER_CONCURRENCY=10

# Standalone production compose (set explicitly before use)
NEIRONYCH_IMAGE=
APP_REVISION=
POSTGRES_USER=neironych
POSTGRES_DB=neironych
POSTGRES_PASSWORD=

# Treasury: opening external funds only, excluding recorded payment receipts.
# This is an accounting opening balance, never a substitute for getBalance.
OPENING_WORKING_CAPITAL_USDT=0
REQUIRED_PROVIDER_FLOAT_USDT=0
WALLET_REFRESH_SECONDS=60
NATIVE_REQUEST_TIMEOUT_SECONDS=600

# Published legal documents are required to open Telegram onboarding.
TERMS_URL=
PRIVACY_POLICY_URL=
LEGAL_DOCUMENT_VERSION=2026-09-19
# Keep in the Russian production/storage contour; back up with the database.
SUPPORT_STORAGE_DIR=/data/support
